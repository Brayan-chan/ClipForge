# Gemini API Key for server-side transcription and JSON clip candidate evaluation (optional for 0-cost heuristic mode)
GEMINI_API_KEY=
PORT=3000

# Maximum video upload size in MB for chunked local uploads (default: 2048 = 2 GB)
MAX_VIDEO_SIZE_MB=2048

# Cloudflare R2 media storage. Use an R2 S3 token with Object Read & Write
# scoped to the selected bucket. Do not expose these credentials to Vite.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=clips
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional only for a public bucket/custom domain. Leave blank for private R2;
# ClipForge will serve short-lived signed GET redirects through /api/media/*.
S3_PUBLIC_BASE_URL=

# Firestore subtitle storage (server-side service account, not Firebase web config)
# Preferred locally: absolute path to the downloaded service-account JSON.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=clipforge-fd7cb
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudinary thumbnail storage (server-side only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
