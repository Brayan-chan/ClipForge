# Gemini API Key for server-side transcription and JSON clip candidate evaluation (optional for 0-cost heuristic mode)
GEMINI_API_KEY=
PORT=3000

# Maximum video upload size in MB for chunked local uploads (default: 2048 = 2 GB)
MAX_VIDEO_SIZE_MB=2048

# Optional Cloudflare R2 / AWS S3 object storage for direct multi-GB browser uploads (Audio-First streaming)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
